# Optional RPC override, read by config.load_config() when config.yaml uses
# ${BASE_RPC_URL:-...}. The fallback in config.yaml is used when unset.
# Use the matching endpoint for `network` (Base mainnet vs Base Sepolia).
BASE_RPC_URL=https://sepolia.base.org

# Private key used by scripts/wrap_weth.py, scripts/approve_weth.py,
# scripts/mint_position.py and scripts/rebalance.py (LIVE). Never commit a
# real key: .env is git-ignored. The derived address must match
# wallet.address in config.yaml; scripts refuse to sign otherwise.
# The read-only scripts (monitor_pool, list_positions) do not need it.
PRIVATE_KEY=

