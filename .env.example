# Optional RPC override slot. Not read yet: the endpoint comes from
# config.yaml (networks.<network>.rpc_url).
BASE_RPC_URL=https://mainnet.base.org

# Private key used by scripts/wrap_weth.py, scripts/approve_weth.py and
# scripts/mint_position.py. Never commit a real key: .env is git-ignored.
# The read-only scripts (monitor_pool, list_positions) do not need it.
PRIVATE_KEY=

